# ==============================================================================
# Template Cero — Variables de Entorno (Opcionales)
# ==============================================================================
# Nota: La aplicación funciona al 100% de manera autónoma sin ninguna de estas
# variables configuradas (modo demostración con almacenamiento local).
#
# Para activar backend real con persistencia en la nube, completa los valores:

# Google Analytics 4 (analytics.ts)
# Dejar vacío en desarrollo; los eventos se enviarán a console / dataLayer.
VITE_GA4_ID=

# Supabase (PostgreSQL + Auth + Storage)
# Consulta SUPABASE.md para el paso a paso de configuración.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
